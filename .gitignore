# Transient run logs — evidence lives in the *_report.json files, which ARE committed
*.log
__pycache__/
*.pyc

# Built site: generated by pipeline/build_site.py, deployed from CI. Derived, never committed.
_site/

# Scratch selection lists from interactive runs; the run record itself IS committed
run/selection.json

# Derived API audits; CI artifacts retain the evidence snapshot.
run/typesafe-*.json
run/typesafe-*.md
run/typesafe-cache/
run/live-audit-*/
